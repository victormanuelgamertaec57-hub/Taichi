# Netlify _headers file
# https://docs.netlify.com/routing/headers/

# ─── Static assets — long cache, immutable (Vite adds hash to filename) ────
# JS / CSS bundles have a hash in the filename (e.g. index-abc123.js) so
# they can be cached forever. Update the cache only when the hash changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# WebP images (served from /assets/*.webp with hash)
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# ─── HTML — always revalidate so deploys are picked up immediately ──────────
/*
  Cache-Control: public, max-age=0, must-revalidate
